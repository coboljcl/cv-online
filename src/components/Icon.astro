---
// Single source of truth for every reusable SVG glyph in the site.
// Stroke icons render with `fill="none" stroke="currentColor"`; pass
// `variant="fill"` for solid brand icons (social links).
// Extra attributes (e.g. `data-scroll-icon`) are forwarded to the <svg>.
interface Props {
	name: string;
	class?: string;
	variant?: "stroke" | "fill";
	strokeWidth?: number;
}

