---

{PATHS[name] && (
	<svg
		aria-hidden="true"
		focusable="false"
		viewBox="0 0 24 24"
		fill={variant === "fill" ? "currentColor" : "none"}
		stroke={variant === "fill" ? "none" : "currentColor"}
		class={className}
		{...rest}
	>
		{PATHS[name].map((d) => (
			<path
				stroke-linecap={variant === "stroke" ? "round" : undefined}
				stroke-linejoin={variant === "stroke" ? "round" : undefined}
				stroke-width={variant === "stroke" ? strokeWidth : undefined}
				d={d}
			/>
		))}
	</svg>
)}
