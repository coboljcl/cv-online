---
import SectionHeading from './SectionHeading.astro';
import type { SkillGroup } from '../types/cv';

interface Props {
	skillGroups: SkillGroup[];
}

const { skillGroups } = Astro.props;
const technologySkills = new Set(["HTML", "CSS", "JavaScript"]);
const complementarySkills = [...new Set(
	skillGroups
		.filter((group) => group.category === "Web & Desarrollo" || group.category === "Idiomas")
		.flatMap((group) => group.skills.filter((skill) => !technologySkills.has(skill))),
)];
---

<section id="habilidades" class="py-20 lg:py-24 px-8 lg:px-16 bg-surface">
	<div class="max-w-6xl mx-auto">
		<SectionHeading label="Complementos" title="Práctica y perfil" icon="habilidades" />
		<p class="skills-intro reveal">Prácticas complementarias al stack técnico e idioma de trabajo.</p>

		{complementarySkills.length > 0 && (
			<div class="skills-grid">
				<div class="reveal skill-group-card bg-surface-alt rounded-xl p-6 md:p-8 border border-line">
					<div class="flex flex-wrap gap-2.5">
						{complementarySkills.map((skill) => (
							<span class="skill-tag text-sm font-medium bg-nav text-text-muted hover:text-white hover:bg-primary px-4 py-2 rounded-lg border border-line cursor-default">
								{skill}
							</span>
						))}
					</div>
				</div>
			</div>
		)}
	</div>
</section>
