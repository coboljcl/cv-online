---
import SectionHeading from './SectionHeading.astro';
import type { EducationItem } from '../types/cv';

interface Props {
	education: EducationItem[];
}

const { education } = Astro.props;
---

<section id="educacion" class="py-20 lg:py-24 px-8 lg:px-16 bg-bg">
	<div class="max-w-6xl mx-auto">
		<SectionHeading label="Formación" title="Educación" icon="educacion" />

		<div class="grid md:grid-cols-2 gap-6">
			{education.map((edu, i) => (
				<div
					class="reveal bg-surface-alt rounded-xl p-6 md:p-8 border border-line hover:border-primary/40 transition-colors"
					class:list={{ 'reveal-delay-1': i === 1 }}
				>
					<div class="flex items-start gap-4">
						<div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center shrink-0">
							<svg class="w-5 h-5 text-primary" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
							</svg>
						</div>
						<div>
							<h3 class="text-lg font-bold text-white">{edu.degree}</h3>
							<p class="text-text-muted text-sm mt-1">{edu.institution}</p>
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
