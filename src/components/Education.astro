---
import SectionHeading from './SectionHeading.astro';
import type { EducationItem } from '../types/cv';

interface Props {
	education: EducationItem[];
}

const { education } = Astro.props;
---

<section id="educacion" class="py-20 lg:py-24 px-8 lg:px-16 bg-bg">
	<div class="max-w-6xl mx-auto">
		<SectionHeading label="Formación" title="Educación" icon="educacion" />

		<div class="education-panel reveal">
			<div class="grid md:grid-cols-2 gap-4">
				{education.map((edu, i) => (
					<article class="education-card" class:list={{ 'reveal-delay-1': i === 1 }}>
						<div class="education-card-meta">
							<div class="education-icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" focusable="false">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z" />
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10v6" />
								</svg>
							</div>
							<span class="education-index">{String(i + 1).padStart(2, '0')}</span>
						</div>
						<h3>{edu.degree}</h3>
						<p>{edu.institution}</p>
					</article>
				))}
			</div>
		</div>
	</div>
</section>
