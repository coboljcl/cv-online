---
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
import type { EducationItem } from "../types/cv";

interface Props {
	education: EducationItem[];
}

const { education } = Astro.props;
---

<section id="educacion" class="py-20 lg:py-24 px-8 lg:px-16 bg-bg">
	<div class="max-w-6xl mx-auto">
		<SectionHeading label="Formación" title="Educación" icon="educacion" />

		<div class="education-panel reveal">
			<div class="grid md:grid-cols-2 gap-4">
				{education.map((edu, i) => (
					<article class="education-card" class:list={{ "reveal-delay-1": i === 1 }}>
						<div class="education-card-meta">
							<div class="education-icon" aria-hidden="true">
								<Icon name="educacion" />
							</div>
							<span class="education-index">{String(i + 1).padStart(2, "0")}</span>
						</div>
						<h3>{edu.degree}</h3>
						<p>{edu.institution}</p>
					</article>
				))}
			</div>
		</div>
	</div>
</section>
