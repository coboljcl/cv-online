---
import SectionHeading from './SectionHeading.astro';
const { profile } = Astro.props;
---

<section id="perfil" class="py-20 lg:py-24 px-8 lg:px-16 bg-surface">
	<div class="max-w-6xl mx-auto">
		<SectionHeading label="Sobre mí" title="Perfil Profesional" icon="perfil" />

		<div class="reveal reveal-delay-1 bg-surface-alt rounded-2xl p-8 md:p-12 border border-line">
			<p class="text-lg md:text-xl text-text leading-relaxed font-light md:text-justify">{profile}</p>

			<!-- Cifras destacadas -->
			<div class="grid grid-cols-2 sm:grid-cols-4 gap-8 mt-10 pt-10 border-t border-line">
				<div class="flex flex-col items-center text-center">
					<div class="w-11 h-11 rounded-xl bg-primary/15 border border-primary/30 flex items-center justify-center mb-3">
						<svg class="w-5 h-5 text-primary" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
						</svg>
					</div>
					<p class="text-3xl font-extrabold text-white">2.5+</p>
					<p class="text-xs text-text-muted mt-1 uppercase tracking-wider">años de experiencia</p>
				</div>
				<div class="flex flex-col items-center text-center">
					<div class="w-11 h-11 rounded-xl bg-primary/15 border border-primary/30 flex items-center justify-center mb-3">
						<svg class="w-5 h-5 text-primary" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
						</svg>
					</div>
					<p class="text-3xl font-extrabold text-white">100+</p>
					<p class="text-xs text-text-muted mt-1 uppercase tracking-wider">programas implementados</p>
				</div>
				<div class="flex flex-col items-center text-center">
					<div class="w-11 h-11 rounded-xl bg-primary/15 border border-primary/30 flex items-center justify-center mb-3">
						<svg class="w-5 h-5 text-primary" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11m16-11v11M8 14v3m4-3v3m4-3v3" />
						</svg>
					</div>
					<p class="text-3xl font-extrabold text-white">3</p>
					<p class="text-xs text-text-muted mt-1 uppercase tracking-wider">entidades bancarias</p>
				</div>
				<div class="flex flex-col items-center text-center">
					<div class="w-11 h-11 rounded-xl bg-primary/15 border border-primary/30 flex items-center justify-center mb-3">
						<svg class="w-5 h-5 text-primary" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9z" />
						</svg>
					</div>
					<p class="text-3xl font-extrabold text-white">COBOL</p>
					<p class="text-xs text-text-muted mt-1 uppercase tracking-wider">stack principal</p>
				</div>
			</div>
		</div>
	</div>
</section>
