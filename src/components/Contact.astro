---
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
import { socials } from "../data/cv";
// Formulario de contacto conectado a Web3Forms (sin backend).
// Anti-spam activo: hCaptcha (data-captcha) + Advanced Spam Filter "Strict"
// configurado en el panel de Web3Forms. La key es PÚBLICA por diseño
// (solo permite recibir mensajes en este correo).
// Honeypot (_honey/botcheck) NO se usa: deprecado por el proveedor, que
// recomienda captcha como protección (https://docs.web3forms.com/getting-started/customizations/spam-protection).
// ---------------------------------------------------------------
const FORM_ENDPOINT = "https://api.web3forms.com/submit";
const ACCESS_KEY = "ee7a6d75-71c7-4d40-9749-747768cee065";
---

<section id="contacto" class="py-20 lg:py-24 px-8 lg:px-16 bg-bg">
	<div class="max-w-6xl mx-auto">
		<div class="contact-panel">
			<div class="contact-intro reveal">
				<SectionHeading label="Contacto" title="¿Trabajamos juntos?" icon="contacto" />
				<div class="contact-availability">
					<span class="status-dot" aria-hidden="true"></span>
					<span>Disponible para nuevas oportunidades</span>
				</div>
				<p class="contact-intro-copy">
					Estoy abierto a oportunidades laborales y colaboraciones en desarrollo de sistemas y mantenimiento de
					aplicaciones.
				</p>

				<div class="contact-socials" aria-label="Perfiles profesionales">
					{socials.map((s) => (
						<a href={s.href} target="_blank" rel="noopener noreferrer">
							<Icon name={s.icon} variant="fill" />
							{s.label}
						</a>
					))}
				</div>
			</div>

			<form id="contact-form" data-endpoint={FORM_ENDPOINT} class="contact-form reveal reveal-delay-1">
				<input type="hidden" name="access_key" value={ACCESS_KEY} />
				<div class="contact-form-grid">
					<div>
						<label for="name">Nombre completo *</label>
						<input id="name" name="name" type="text" autocomplete="name" required placeholder="Ej: Carlos Gómez" />
					</div>
					<div>
						<label for="email">Correo electrónico *</label>
						<input
							id="email"
							name="email"
							type="email"
							autocomplete="email"
							required
							placeholder="carlos@empresa.com"
						/>
					</div>
				</div>
				<div>
					<label for="subject">Asunto o proyecto *</label>
					<input id="subject" name="subject" type="text" required placeholder="Motivo de contacto" />
				</div>
				<div>
					<label for="message">Mensaje *</label>
					<textarea
						id="message"
						name="message"
						rows="5"
						required
						placeholder="Contame brevemente sobre la oportunidad o colaboración."
					></textarea>
				</div>

				<div class="h-captcha" data-captcha="true"></div>

				<div>
					<button type="submit" aria-describedby="form-guidance">
						Enviar mensaje
						<Icon name="arrow-right" />
					</button>
					<p id="form-guidance">Tus datos se usan únicamente para responder a tu consulta.</p>
					<p id="form-status" role="status" aria-live="polite"></p>
				</div>
			</form>
		</div>
	</div>
</section>

<script>
	const form = document.getElementById("contact-form") as HTMLFormElement | null;
	if (form) {
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			const status = document.getElementById("form-status");
			const button = form.querySelector<HTMLButtonElement>("button[type='submit']");
			const endpoint = form.dataset.endpoint;

			if (!endpoint || endpoint === "@") {
				if (status) status.textContent = "El formulario aún no está configurado para enviar. Gracias por tu interés.";
				return;
			}

			if (!button) return;
			button.disabled = true;
			if (status) status.textContent = "Enviando...";

			const data = new FormData(form);
			try {
				const res = await fetch(endpoint, {
					method: "POST",
					body: data,
					headers: { Accept: "application/json" },
				});
				const json = await res.json();
				if (json.success) {
					form.reset();
					if (status) status.textContent = "¡Mensaje enviado con éxito! Te responderé pronto.";
				} else {
					throw new Error(json.message || "error");
				}
			} catch {
				if (status) status.textContent = "No se pudo enviar. Inténtalo de nuevo o usa otro medio de contacto.";
			} finally {
				button.disabled = false;
			}
		});
	}
</script>

<script>
	const loadCaptchaProvider = () => {
		if (document.getElementById("web3forms-client-script")) return;
		const script = document.createElement("script");
		script.id = "web3forms-client-script";
		script.src = "https://web3forms.com/client/script.js";
		script.async = true;
		script.defer = true;
		document.head.appendChild(script);
	};

	const contactSection = document.getElementById("contacto");
	const contactForm = document.getElementById("contact-form");
	if (contactSection && "IntersectionObserver" in window) {
		const captchaObserver = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				loadCaptchaProvider();
				captchaObserver.disconnect();
			},
			{ rootMargin: "300px" },
		);
		captchaObserver.observe(contactSection);
	} else {
		loadCaptchaProvider();
	}

	contactForm?.addEventListener("focusin", loadCaptchaProvider, { once: true });
	contactForm?.addEventListener("pointerenter", loadCaptchaProvider, { once: true });
</script>
