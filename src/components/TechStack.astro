---
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";

interface Props {
	title?: string;
	tools: { name: string; level: number }[];
}

const { title = "Tecnologías destacadas" } = Astro.props;
const pillarIconNames = ["monitor", "db-grid", "code-box", "tecnologias"];
const pillars = [
	{
		title: "Core Mainframe",
		description: "Desarrollo y mantenimiento de aplicaciones bancarias en entorno mainframe.",
		tools: ["COBOL", "CICS", "JCL", "Mainframe"],
	},
	{
		title: "Datos & SQL",
		description: "Trabajo con datos y sentencias SQL sobre DB2.",
		tools: ["DB2", "SQL", "Cursores (Open, Fetch, Close)", "Bases de datos en DEV"],
	},
	{
		title: "Ecosistema & Ops",
		description: "Herramientas de trabajo y soporte para el ciclo de desarrollo.",
		tools: ["ISPF", "HOST", "UltraEdit", "JIRA", "REMEDY"],
	},
	{
		title: "Evolución & Web",
		description: "Base de desarrollo web complementaria al trabajo de evolución de sistemas.",
		tools: ["HTML", "CSS", "JavaScript", "VisualStudio"],
	},
];
---

<section id="tecnologias" class="py-20 lg:py-24 px-8 lg:px-16 bg-surface">
	<div class="max-w-6xl mx-auto">
		<SectionHeading label="Dominio técnico" title={title} icon="tecnologias" />

		<div class="tech-pillars">
			{pillars.map((pillar, index) => (
				<article
					class="tech-pillar reveal"
					class:list={{ "reveal-delay-1": index % 2 === 1, "reveal-delay-2": index >= 2 }}
				>
					<div class="tech-pillar-title-row">
						<div class="tech-pillar-icon" aria-hidden="true">
							<Icon name={pillarIconNames[index]} strokeWidth={1.8} />
						</div>
						<h3>{pillar.title}</h3>
					</div>
					<p>{pillar.description}</p>
					<ul aria-label={`Tecnologías de ${pillar.title}`}>
						{pillar.tools.map((tool) => (
							<li>{tool}</li>
						))}
					</ul>
				</article>
			))}
		</div>
	</div>
</section>
