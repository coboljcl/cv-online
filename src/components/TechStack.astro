---
import SectionHeading from './SectionHeading.astro';
interface Props {
	title?: string;
	tools: { name: string; level: number }[];
}

const { title = "Tecnologías destacadas", tools } = Astro.props;
---
<section id="tecnologias" class="py-20 lg:py-24 px-8 lg:px-16 bg-surface">
	<div class="max-w-6xl mx-auto">
		<SectionHeading label="Dominio técnico" title={title} icon="tecnologias" />

		<div class="grid sm:grid-cols-2 gap-x-14 gap-y-10">
			{tools.map((tool, i) => (
				<div class="reveal" class:list={{ 'reveal-delay-1': i % 2 === 1 }}>
					<div class="flex items-center justify-between mb-3">
						<span class="text-lg font-semibold text-white">{tool.name}</span>
						<span class="text-sm text-text-muted font-mono">{tool.level}%</span>
					</div>
					<div class="h-3.5 rounded-full bg-line overflow-hidden">
						<div
							class="h-full rounded-full bg-gradient-to-r from-primary to-primary-light"
							style={`width: ${tool.level}%`}
						></div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
