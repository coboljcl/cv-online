---
import SectionHeading from './SectionHeading.astro';
import type { ExperienceItem } from '../types/cv';

interface Props {
	experience: ExperienceItem[];
}

const { experience } = Astro.props;
---

<section id="experiencia" class="py-20 lg:py-24 px-8 lg:px-16 bg-bg">
	<div class="max-w-6xl mx-auto">
		<SectionHeading label="Trayectoria" title="Experiencia Laboral" icon="experiencia" />

		<div class="space-y-5">
			{experience.map((job, index) => (
				<details open={index === 0} class="reveal group bg-surface-alt rounded-xl border border-line hover:border-primary/40 transition-colors overflow-hidden">
					<summary class="flex items-center justify-between gap-4 p-6 md:p-8 cursor-pointer select-none list-none">
						<div>
							<h3 class="text-lg md:text-xl font-bold text-white">{job.position}</h3>
							<p class="text-primary font-medium">{job.company}</p>
							{job.tagline && <p class="text-text-muted text-sm mt-1">{job.tagline}</p>}
						</div>
						<div class="flex items-center gap-3 shrink-0">
							<span class="text-sm text-text-muted bg-surface px-3 py-1.5 rounded-full font-medium border border-line">{job.duration}</span>
							<svg class="w-5 h-5 text-primary transition-transform duration-300 group-open:rotate-180" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
							</svg>
						</div>
					</summary>

					<div class="px-6 md:px-8 pb-6 md:pb-8">
						<ul class="space-y-2">
							{job.highlights.map((resp) => (
								<li class="flex items-start gap-2 text-text/80 text-sm md:text-base leading-relaxed">
									<svg class="w-5 h-5 text-primary shrink-0 mt-0.5" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
									</svg>
									<span>{resp}</span>
								</li>
							))}
						</ul>

						{job.tech && (
							<div class="mt-4 pt-4 border-t border-line">
								<p class="text-xs text-text-muted uppercase tracking-wider font-semibold mb-2">Tecnologías</p>
								<div class="flex flex-wrap gap-2">
									{job.tech.split(',').map((t) => (
										<span class="skill-tag text-xs font-medium bg-primary/10 text-primary-light px-3 py-1 rounded-full">
											{t.trim()}
										</span>
									))}
								</div>
							</div>
						)}
					</div>
				</details>
			))}
		</div>
	</div>
</section>
