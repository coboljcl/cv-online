---
import SectionHeading from "./SectionHeading.astro";
import Icon from "./Icon.astro";
import type { ExperienceItem } from "../types/cv";

interface Props {
	experience: ExperienceItem[];
}

const { experience } = Astro.props;

const formatCompanyContext = (company: string) => {
	const match = company.match(/^(.+) \(CLIENTE: (.+)\)$/);
	return match ? { intermediary: match[1], client: match[2] } : { intermediary: company, client: undefined };
};
---

<section id="experiencia" class="py-20 lg:py-24 px-8 lg:px-16 bg-bg">
	<div class="max-w-6xl mx-auto">
		<SectionHeading label="Trayectoria" title="Experiencia Laboral" icon="experiencia" />

		<ol class="experience-timeline" aria-label="Cronología de experiencia laboral">
			{experience.map((job, index) => {
				const company = formatCompanyContext(job.company);

				return (
					<li
						class="experience-entry reveal"
						class:list={{ "reveal-delay-1": index === 1, "reveal-delay-2": index >= 2 }}
					>
						<div class="experience-marker" aria-hidden="true">
							<span></span>
						</div>
						<div class="experience-card">
							<header class="experience-card-header">
								<div class="min-w-0">
									<p class="experience-index">{String(index + 1).padStart(2, "0")} / EXPERIENCIA</p>
									<h3 class="text-xl md:text-2xl font-bold text-white">{job.position}</h3>
									<p class="mt-2 text-primary font-semibold">{company.intermediary}</p>
									{company.client && <p class="text-text-muted text-sm">Cliente: {company.client}</p>}
									{job.tagline && <p class="text-text-muted text-sm mt-3">{job.tagline}</p>}
								</div>
								<span class="experience-duration">{job.duration}</span>
							</header>

							<div class="experience-card-body">
								<div>
									<h4 class="experience-subheading">Responsabilidades</h4>
									<ul class="experience-responsibilities">
										{job.highlights.map((responsibility) => (
											<li>
												<Icon name="check-circle" class="w-5 h-5" />
												<span>{responsibility}</span>
											</li>
										))}
									</ul>
								</div>

								{job.tech && (
									<div class="experience-technologies">
										<h4 class="experience-subheading">Tecnologías</h4>
										<div class="flex flex-wrap gap-2">
											{job.tech.split(",").map((technology) => (
												<span class="skill-tag text-xs font-medium bg-primary/10 text-primary-light px-3 py-1 rounded-full">
													{technology.trim()}
												</span>
											))}
										</div>
									</div>
								)}
							</div>
						</div>
					</li>
				);
			})}
		</ol>
	</div>
</section>
