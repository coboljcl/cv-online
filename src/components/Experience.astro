---
import SectionHeading from './SectionHeading.astro';
const { experience } = Astro.props;
---

<section id="experiencia" class="py-20 lg:py-24 px-8 lg:px-16 bg-bg">
	<div class="max-w-6xl mx-auto">
		<SectionHeading label="Trayectoria" title="Experiencia Laboral" icon="experiencia" />

		<div class="relative">
			<!-- Timeline line -->
			<div class="absolute left-4 md:left-8 top-0 bottom-0 w-0.5 bg-line">
				<div class="timeline-line w-full bg-primary"></div>
			</div>

			<div class="space-y-10">
				{experience.map((job, index) => (
					<div
						class:list={[
							'reveal',
							'relative',
							'pl-12',
							'md:pl-16',
							index === 1 ? 'reveal-delay-1' : '',
							index === 2 ? 'reveal-delay-2' : '',
						]}
					>
						<!-- Timeline dot -->
						<div class="absolute left-2 md:left-6 top-1 w-4 h-4 rounded-full bg-primary border-2 border-bg shadow-md glow-pulse"></div>

						<!-- Card -->
						<div class="bg-surface-alt rounded-xl p-6 md:p-8 border border-line hover:border-primary/40 transition-colors">
							<div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4 gap-2">
								<div>
									<h3 class="text-xl font-bold text-white">{job.position}</h3>
									<p class="text-primary font-medium">{job.company}</p>
									{job.tagline && <p class="text-text-muted text-sm mt-1">{job.tagline}</p>}
								</div>
								<span class="text-sm text-text-muted bg-surface px-4 py-1.5 rounded-full font-medium border border-line">
									{job.duration}
								</span>
							</div>

							<ul class="space-y-2">
								{job.highlights.map((resp) => (
									<li class="flex items-start gap-2 text-text/80 text-sm md:text-base leading-relaxed">
										<svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
										</svg>
										<span>{resp}</span>
									</li>
								))}
							</ul>

							{(job.highlights && job.tech) && (
								<div class="mt-4 pt-4 border-t border-line">
									<p class="text-xs text-text-muted uppercase tracking-wider font-semibold mb-2">Tecnologías</p>
									<div class="flex flex-wrap gap-2">
										{job.tech.split(',').map((t) => (
											<span class="skill-tag text-xs font-medium bg-primary/10 text-primary-light px-3 py-1 rounded-full">
												{t.trim()}
											</span>
										))}
									</div>
								</div>
							)}
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>
