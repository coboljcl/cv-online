---
interface Props {
	label: string;
	title: string;
	icon?: string;
}

const { label, title, icon } = Astro.props;

const glyphs: Record<string, string> = {
	perfil: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
	trayectoria: "M5 2v12l-2 2m3-14h12a2 2 0 012 2v10a2 2 0 01-2 2H7a2 2 0 01-2-2V3z",
	experiencia: "M5 7h14M5 4h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2zM9 12h6",
	educacion: "M12 14l9-5-9-5-9 5 9 5zM12 14l6.16-3.42a12 12 0 01.67 6.48A12 12 0 0112 20.06a12 12 0 00-6.83-3A12 12 0 015.84 10.58L12 14zM5 8v6",
	tecnologias: "M8 9l-4 3 4 3M16 9l4 3-4 3M13 5l-2 14",
	habilidades: "M12 15a3 3 0 100-6 3 3 0 000 6zM5 12h2m10 0h2M12 5v2m0 10v2M6.34 6.34l1.41 1.41m8.49 8.49l1.41 1.41m0-11.31l-1.41 1.41M7.75 16.25l-1.41 1.41",
	contacto: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
};
---

<div class="reveal mb-10">
	{icon && (
		<div class="w-11 h-11 rounded-xl bg-primary/15 border border-primary/30 flex items-center justify-center mb-3">
			<svg class="section-heading-icon w-5 h-5 text-primary" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={glyphs[icon]} />
			</svg>
		</div>
	)}
	<p class="text-xs font-semibold uppercase tracking-[0.2em] text-primary mb-2">{label}</p>
	<h2 class="text-3xl md:text-4xl font-extrabold text-white">{title}</h2>
</div>
