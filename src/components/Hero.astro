---
const { name, title } = Astro.props;
---

<section id="inicio" class="hero-mainframe relative flex items-stretch overflow-hidden bg-bg">
	<div class="relative z-10 grid w-full max-w-[1240px] mx-auto items-center gap-10 px-6 py-6 xl:grid-cols-[1.1fr_0.9fr] xl:px-6 xl:py-10">
		<div class="max-w-2xl">
			<p class="hero-slide-up hero-availability mb-5">
				<span class="status-dot" aria-hidden="true"></span>
				Disponible para nuevas oportunidades
			</p>

			<p class="hero-slide-up hero-eyebrow" style="animation-delay: 0.05s">
				Arquitectura de misión crítica
			</p>
			<h1
				class="hero-slide-up mb-6 text-4xl font-extrabold leading-[1.08] text-white sm:text-5xl lg:text-6xl"
				style="animation-delay: 0.1s"
			>
				Programador <span class="text-primary">COBOL &amp;</span>
				<span class="block">Mainframe</span>
			</h1>

			<p
				class="hero-slide-up max-w-xl text-base leading-relaxed text-text-muted md:text-lg"
				style="animation-delay: 0.2s"
			>
				Desarrollo y mantenimiento de aplicaciones COBOL en entornos Mainframe para el sector bancario.
			</p>

			<div class="hero-slide-up mt-7 flex flex-wrap items-center gap-3" style="animation-delay: 0.3s">
				<a href="#contacto" class="hero-cta hero-cta-primary">
					Contactar ahora
					<svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5l7 7-7 7" />
					</svg>
				</a>
				<a href="#experiencia" class="hero-cta hero-cta-secondary">
					<svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M3 21h18M5 21V9l7-5 7 5v12M9 21v-6h6v6"
						/>
					</svg>
					Ver experiencia bancaria
				</a>
				<a href="#contacto" class="hero-cta hero-cta-tertiary">
					<svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M12 3v12m0 0l4-4m-4 4l-4-4M5 21h14"
						/>
					</svg>
					Solicitar CV (PDF)
				</a>
			</div>

			<div class="hero-slide-up hero-micro-metrics" style="animation-delay: 0.4s" aria-label="Tecnologías principales">
				<span>
					<svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<rect x="5" y="5" width="14" height="14" rx="2" />
						<path d="M9 1v4m6-4v4M9 19v4m6-4v4M1 9h4m-4 6h4m14-6h4m-4 6h4" />
					</svg>
					IBM z/OS
				</span>
				<span>
					<svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<ellipse cx="12" cy="5" rx="7" ry="3" />
						<path d="M5 5v7c0 1.66 3.13 3 7 3s7-1.34 7-3V5m-14 7v7c0 1.66 3.13 3 7 3s7-1.34 7-3v-7" />
					</svg>
					DB2
				</span>
				<span>
					<svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" />
					</svg>
					CICS
				</span>
				<span>
					<svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path d="M5 3h11l3 3v15H5zM16 3v4h3M8 11h8M8 15h5M8 19h8" />
					</svg>
					JCL
				</span>
			</div>
		</div>

		<div
			class="hero-slide-up terminal-frame"
			style="animation-delay: 0.2s"
			aria-label={`${name}, ${title}: presentación estática de código COBOL en ISPF`}
		>
			<div class="terminal-frame-bar">
				<div class="flex items-center gap-2 min-w-0">
					<div class="flex gap-1.5" aria-hidden="true">
						<span></span>
						<span></span>
						<span></span>
					</div>
					<p class="truncate">ISPF 3.4 — SYS1.COBOL.PROD(PORTFOLIO)</p>
				</div>
				<button
					type="button"
					class="terminal-copy"
					aria-label="Copiar código COBOL"
					aria-describedby="terminal-copy-status"
				>
					<svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<rect x="9" y="9" width="11" height="11" rx="1" />
						<path d="M15 9V5a1 1 0 00-1-1H5a1 1 0 00-1 1v9a1 1 0 001 1h4" />
					</svg>
					Copy
				</button>
			</div>
			<div class="terminal-source" aria-label="Código COBOL de ejemplo">
				<ol id="terminal-cobol-source" class="terminal-source-lines">
					<li>
						<span class="terminal-line-number" aria-hidden="true">
							000100
						</span>
						<code data-terminal-source-code>
							<span class="terminal-keyword">IDENTIFICATION DIVISION.</span>
						</code>
					</li>
					<li>
						<span class="terminal-line-number" aria-hidden="true">
							000200
						</span>
						<code data-terminal-source-code>
							<span class="terminal-keyword">PROGRAM-ID.</span> PORTFOLIO-MAINFRAME.
						</code>
					</li>
					<li>
						<span class="terminal-line-number" aria-hidden="true">
							000300
						</span>
						<code data-terminal-source-code>
							<span class="terminal-comment">************************************************</span>
						</code>
					</li>
					<li>
						<span class="terminal-line-number" aria-hidden="true">
							000400
						</span>
						<code data-terminal-source-code>
							<span class="terminal-keyword">DATA DIVISION.</span>
						</code>
					</li>
					<li>
						<span class="terminal-line-number" aria-hidden="true">
							000500
						</span>
						<code data-terminal-source-code>
							<span class="terminal-keyword">WORKING-STORAGE SECTION.</span>
						</code>
					</li>
					<li>
						<span class="terminal-line-number" aria-hidden="true">
							000600
						</span>
						<code data-terminal-source-code>
							01 <span class="terminal-name">WS-STATUS</span> <span class="terminal-keyword">PIC</span> X(10){" "}
							<span class="terminal-keyword">VALUE</span> <span class="terminal-value">'READY'</span>.
						</code>
					</li>
					<li>
						<span class="terminal-line-number" aria-hidden="true">
							000700
						</span>
						<code data-terminal-source-code>
							01 <span class="terminal-name">WS-DATABASE</span> <span class="terminal-keyword">PIC</span> X(03){" "}
							<span class="terminal-keyword">VALUE</span> <span class="terminal-value">'DB2'</span>.
						</code>
					</li>
					<li>
						<span class="terminal-line-number" aria-hidden="true">
							000800
						</span>
						<code data-terminal-source-code>
							<span class="terminal-comment">************************************************</span>
						</code>
					</li>
					<li>
						<span class="terminal-line-number" aria-hidden="true">
							000900
						</span>
						<code data-terminal-source-code>
							<span class="terminal-keyword">PROCEDURE DIVISION.</span>
						</code>
					</li>
					<li>
						<span class="terminal-line-number" aria-hidden="true">
							001000
						</span>
						<code data-terminal-source-code>
							{" "}
							<span class="terminal-keyword">PERFORM</span> 1000-PROCESS-BANKING
						</code>
					</li>
					<li>
						<span class="terminal-line-number" aria-hidden="true">
							001100
						</span>
						<code data-terminal-source-code>
							{" "}
							<span class="terminal-keyword">GOBACK.</span>
						</code>
					</li>
				</ol>
			</div>
			<p id="terminal-copy-status" class="sr-only" role="status" aria-live="polite"></p>
			<div class="terminal-status-row">
				<div>
					<strong>STATUS:</strong> <span>CC 0000 (SUCCESS)</span>
				</div>
				<div>
					<span>
						SYSTEM: <strong>IBM z/OS</strong>
					</span>
					<span>
						DB2: <strong>CONNECTED</strong>
					</span>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const copyButton = document.querySelector<HTMLButtonElement>(".terminal-copy");
	const source = document.querySelector<HTMLElement>("#terminal-cobol-source");
	const copyStatus = document.querySelector<HTMLElement>("#terminal-copy-status");

	copyButton?.addEventListener("click", async () => {
		if (!source || !copyStatus || !navigator.clipboard?.writeText) {
			if (copyStatus) copyStatus.textContent = "No se puede copiar el código en este navegador.";
			return;
		}

		try {
			const sourceText = Array.from(source.querySelectorAll<HTMLElement>("[data-terminal-source-code]"))
				.map((line) => line.textContent ?? "")
				.join("\n");
			await navigator.clipboard.writeText(sourceText);
			copyStatus.textContent = "Código COBOL copiado al portapapeles.";
		} catch {
			copyStatus.textContent = "No se pudo copiar el código. Podés seleccionarlo manualmente.";
		}
	});
</script>
