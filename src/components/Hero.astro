---
const { name, title } = Astro.props;
---

<section id="inicio" class="relative min-h-[calc(100vh-0px)] flex items-stretch overflow-hidden bg-bg">
	<!-- Thin accent border to separate hero from sidebar -->
	<div class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-primary to-accent opacity-40 hidden lg:block"></div>

	<div class="relative z-10 w-full grid lg:grid-cols-[1.2fr_1fr] gap-10 items-center px-8 py-16 lg:px-16 lg:py-0 max-w-6xl mx-auto">
		<!-- ===== Left: intro ===== -->
		<div class="max-w-2xl">
			<!-- eyebrow -->
			<p class="hero-slide-up text-sm font-semibold uppercase tracking-[0.2em] text-text-muted mb-4">
				Bienvenido
			</p>

			<!-- Heading in two lines, accent on the second line -->
			<h1 class="hero-slide-up text-4xl md:text-5xl lg:text-6xl font-extrabold leading-tight text-white mb-6" style="animation-delay: 0.1s">
				Programador COBOL
				<span class="text-primary">Mainframe</span>
			</h1>

			<!-- Subtitle -->
			<p class="hero-slide-up text-base md:text-lg text-text-muted leading-relaxed max-w-lg mb-8 text-justify" style="animation-delay: 0.2s">
				Desarrollo y mantenimiento de aplicaciones Mainframe en entornos bancarios. Garantizo la estabilidad, el rendimiento y la integridad de los sistemas que mueven el negocio.
			</p>

			<!-- CTA -->
			<div class="hero-slide-up flex flex-wrap items-center gap-4 mb-10" style="animation-delay: 0.3s">
				<a href="#contacto" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white text-sm font-semibold uppercase tracking-wide px-7 py-3.5 rounded-lg transition-colors">
					Contactar
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5l7 7-7 7" />
					</svg>
				</a>
				<a href="#proyectos" class="inline-flex items-center gap-2 border-2 border-line hover:border-primary hover:text-primary text-white text-sm font-semibold uppercase tracking-wide px-7 py-3.5 rounded-lg transition-colors">
					Ver proyectos
				</a>
			</div>

			<!-- Featured technologies -->
			<div class="hero-slide-up flex flex-wrap gap-3 mb-12" style="animation-delay: 0.4s">
				{["COBOL", "DB2", "CICS", "JCL", "Mainframe"].map((t) => (
					<span class="skill-tag text-sm font-medium bg-nav text-text-muted hover:text-white hover:bg-primary px-4 py-2 rounded-lg border border-line cursor-default">
						{t}
					</span>
				))}
			</div>

			<!-- Mini stats -->
			<div class="hero-slide-up grid grid-cols-3 gap-6 max-w-md pt-8 border-t border-line" style="animation-delay: 0.5s">
				<div>
					<p class="text-2xl font-extrabold text-white">2.5+</p>
					<p class="text-xs text-text-muted mt-1">años exp.</p>
				</div>
				<div>
					<p class="text-2xl font-extrabold text-white">100+</p>
					<p class="text-xs text-text-muted mt-1">programas</p>
				</div>
				<div>
					<p class="text-2xl font-extrabold text-white">3</p>
					<p class="text-xs text-text-muted mt-1">bancos</p>
				</div>
			</div>
		</div>

		<!-- ===== Right: portrait with geometric backdrop ===== -->
		<div class="relative hidden lg:flex items-center justify-center">
			<div class="relative">
				<!-- accent shapes behind -->
				<div class="absolute -top-6 -right-6 w-40 h-40 bg-primary/20 rounded-2xl rotate-6"></div>
				<div class="absolute -bottom-6 -left-6 w-40 h-40 bg-accent/20 rounded-2xl -rotate-6"></div>
				<!-- portrait -->
				<div class="relative w-[300px] h-[447px] rounded-2xl overflow-hidden shadow-2xl ring-1 ring-line">
					<img src="/assets/profile-hero-full.jpg" alt={`Foto de ${name}`} class="w-full h-full object-cover" />
				</div>
				<!-- floating code-bracket badge -->
				<div class="absolute -top-4 left-1/2 -translate-x-1/2 w-12 h-12 rounded-xl bg-primary flex items-center justify-center shadow-lg">
					<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
					</svg>
				</div>
			</div>
		</div>
	</div>
    </section>
