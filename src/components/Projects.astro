---
import SectionHeading from './SectionHeading.astro';
import type { ProjectItem } from '../types/cv';

interface Props {
	projects: ProjectItem[];
}

const { projects } = Astro.props;
---

<section id="proyectos" class="py-20 lg:py-24 px-8 lg:px-16 bg-bg">
	<div class="max-w-6xl mx-auto">
		<SectionHeading label="Proyectos destacados" title="Lo que he construido" icon="tecnologias" />

		<div class="grid gap-6">
			{projects.map((project, i) => (
				<article class="project-feature reveal" class:list={{ 'reveal-delay-1': i > 0 }}>
					<div class="project-feature-copy">
						<div class="project-feature-kicker">
							<svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v11.494m-9-5.747h18" />
							</svg>
							<span>Proyecto destacado</span>
						</div>
						<h3>{project.title}</h3>
						<p>{project.description}</p>
						<ul class="project-feature-tags" aria-label={`Tecnologías de ${project.title}`}>
							{project.tags.map((tag) => <li>{tag}</li>)}
						</ul>
					</div>

					<div class="project-feature-action">
						<div class="project-feature-status">
							<span aria-hidden="true">&gt;</span>
							<span>PROJECT_OVERVIEW</span>
						</div>
						<p>Conocé el perfil en GitHub y los detalles de este proyecto.</p>
						{project.link && (
							<a href={project.link} target="_blank" rel="noopener noreferrer" aria-label="Ver perfil en GitHub">
								Ver perfil en GitHub
								<svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M7 7h10v10" />
								</svg>
							</a>
						)}
					</div>
				</article>
			))}
		</div>

		<div class="reveal mt-8 flex flex-col items-start justify-between gap-4 rounded-xl border border-line bg-surface p-5 sm:flex-row sm:items-center">
			<div>
				<p class="font-semibold text-white">¿Querés conversar sobre un proyecto?</p>
				<p class="mt-1 text-sm text-text-muted">Ponete en contacto para hablar de oportunidades o colaboraciones.</p>
			</div>
			<a href="#contacto" class="inline-flex shrink-0 items-center gap-2 rounded-lg border border-primary/50 px-4 py-2.5 text-sm font-semibold text-primary transition-colors hover:bg-primary hover:text-white">
				Contactar
				<svg class="h-4 w-4" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5l7 7-7 7" />
				</svg>
			</a>
		</div>
	</div>
</section>
