---
import SectionHeading from './SectionHeading.astro';
import type { ProjectItem } from '../types/cv';

interface Props {
	projects: ProjectItem[];
}

const { projects } = Astro.props;
---

<section id="proyectos" class="py-20 lg:py-24 px-8 lg:px-16 bg-bg">
	<div class="max-w-6xl mx-auto">
		<SectionHeading label="Proyectos destacados" title="Lo que he construido" icon="tecnologias" />

		<div class="grid md:grid-cols-2 gap-6">
			{projects.map((project, i) => (
				<div
					class="reveal bg-surface-alt rounded-xl p-6 md:p-8 border border-line hover:border-primary/40 transition-colors"
					class:list={{ 'reveal-delay-1': i % 2 === 1 }}
				>
					<div class="flex items-start gap-4">
						<div class="w-11 h-11 rounded-xl bg-primary/15 border border-primary/30 flex items-center justify-center shrink-0">
							<svg class="w-5 h-5 text-primary" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h4l2 2h8a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
							</svg>
						</div>
						<div class="flex-1">
							<h3 class="text-lg font-bold text-white">{project.title}</h3>
							<p class="text-text-muted text-sm leading-relaxed mt-1">
								{project.description}
							</p>
							<div class="flex flex-wrap gap-2 mt-4">
								{project.tags.map((tag) => (
									<span class="skill-tag text-xs font-medium bg-nav text-text-muted px-3 py-1 rounded-full border border-line">
										{tag}
									</span>
								))}
							</div>
							{project.link && (
								<a
									href={project.link}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary mt-4 hover:underline"
									aria-label={`Ver proyecto: ${project.title}`}
								>
									Ver proyecto
									<svg class="w-3.5 h-3.5" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
									</svg>
								</a>
							)}
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
