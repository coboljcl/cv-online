---
import type { NavItem } from "../types/cv";
import Icon from "../components/Icon.astro";
import { socials } from "../data/cv";

interface Props {
	name: string;
	title: string;
	navItems: NavItem[];
	footer?: string;
}

const { name, title, navItems, footer = "Todos los derechos reservados" } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL("https://coboljcl.github.io");
const canonicalUrl = new URL(base, site).toString();
const socialImageUrl = new URL(`${base}og-banner.png`, site).toString();
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		{import.meta.env.PROD && (
			<meta
				http-equiv="Content-Security-Policy"
				content="default-src 'self'; script-src 'self' 'unsafe-inline' https://hcaptcha.com https://*.hcaptcha.com https://web3forms.com; style-src 'self' 'unsafe-inline' https://hcaptcha.com https://*.hcaptcha.com; img-src 'self' data: blob: https://hcaptcha.com https://*.hcaptcha.com; connect-src 'self' https://api.web3forms.com https://hcaptcha.com https://*.hcaptcha.com; frame-src https://hcaptcha.com https://*.hcaptcha.com; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://api.web3forms.com"
			/>
		)}
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content={`${name} — ${title} especializado en COBOL, DB2, JCL y CICS en entornos Mainframe para el sector bancario. 100+ programas implementados, más de 3 años de experiencia en sistemas críticos.`}
		/>
		<meta name="theme-color" content="#0a0e17" />
		<meta name="author" content={name} />
		<meta
			name="keywords"
			content="Programador COBOL, Mainframe, DB2, JCL, CICS, desarrollador, ingeniero, sistemas críticos, banca, Allan Zúñiga"
		/>
		<meta property="og:type" content="website" />
		<meta property="og:title" content={`${name} | ${title}`} />
		<meta
			property="og:description"
			content={`${title} especializado en COBOL y Mainframe para el sector bancario. 100+ programas implementados, más de 3 años de experiencia.`}
		/>
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:alt" content={`Retrato profesional de ${name}, ${title}`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={`CV Online — ${name}`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${name} | ${title}`} />
		<meta name="twitter:description" content={`${title} especializado en COBOL y Mainframe para el sector bancario.`} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="twitter:image:alt" content={`Retrato profesional de ${name}, ${title}`} />
		<link rel="preload" href={`${base}fonts/geist-latin.woff2`} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={`${base}fonts/jetbrains-mono-latin.woff2`} as="font" type="font/woff2" crossorigin />
		<link rel="canonical" href={canonicalUrl} />
		<title>{name} | {title} · Mainframe</title>
	</head>
	<body class="font-['Geist',system-ui,sans-serif] bg-bg text-text antialiased overflow-x-hidden">
		<header class="site-header">
			<nav id="site-navigation" class="floating-nav" aria-label="Navegación principal">
				<a class="nav-brand" href="#inicio" aria-label={`Ir al inicio de ${name}`}>
					<span class="nav-avatar">
						<picture>
							<source srcset={`${base}assets/profile-avatar.webp`} type="image/webp" />
							<img
								src={`${base}assets/profile-avatar.jpg`}
								alt={`Foto de ${name}`}
								width="112"
								height="112"
								loading="eager"
								decoding="async"
							/>
						</picture>
					</span>
					<span class="nav-identity">
						<strong>{name}</strong>
						<span>{title}</span>
					</span>
				</a>
				<div class="nav-links" role="list">
					{navItems.map((item) => (
						<a
							href={item.href}
							data-nav
							aria-label={item.label}
							aria-current={item.href === "#inicio" ? "page" : undefined}
							class:list={["nav-item", item.href === "#inicio" ? "is-active" : ""]}
						>
							{item.icon && <Icon name={item.icon} />}
							<span>{item.label}</span>
						</a>
					))}
				</div>
				<a class="nav-contact-cta" href="#contacto">
					<span>Contactar</span>
					<Icon name="arrow-right" />
				</a>
			</nav>
		</header>

		<main class="site-main">
			<div class="content-shell">
				<slot />
			</div>
			<footer class="site-footer">
				<div class="content-shell site-footer-content">
					<div class="footer-top-row">
						<div class="footer-brand">
							<p class="footer-name">
								<span aria-hidden="true">&gt;</span> {name}
							</p>
							<p class="footer-description">
								Especialista COBOL z/OS, DB2, CICS y arquitectura bancaria de alto volumen.
							</p>
						</div>
						<div class="footer-socials" aria-label="Perfiles profesionales">
							{socials.map((s) => (
								<a
									href={s.href}
									class="social-link"
									aria-label={`Abrir perfil de ${s.label} en una nueva pestaña`}
									target="_blank"
									rel="noopener noreferrer"
								>
									<Icon name={s.icon} />
									<span>{s.label}</span>
								</a>
							))}
						</div>
					</div>
					<div class="footer-bottom-row">
						<p>
							© {new Date().getFullYear()} {name}. {footer}.
						</p>
						<p>Diseñado con arquitectura moderna para sistemas bancarios críticos.</p>
					</div>
				</div>
			</footer>
		</main>

		<button id="scroll-indicator" type="button" class="scroll-indicator" aria-label="Ir a la siguiente sección">
			<Icon name="chevron-down" data-scroll-icon="next" class="w-5 h-5" />
			<Icon name="inicio" data-scroll-icon="home" class="w-5 h-5 hidden" />
		</button>

		<script>
			const sections = Array.from(document.querySelectorAll("main section[id]"));
			const getSections = () => sections;
			const navLinks = document.querySelectorAll("#site-navigation a[data-nav]");
			let currentId = "";
			const setActive = (id: string) => {
				currentId = id;
				navLinks.forEach((link) => {
					const isActive = link.getAttribute("href") === `#${id}`;
					link.classList.toggle("is-active", isActive);
					link.toggleAttribute("aria-current", isActive);
					if (isActive) link.setAttribute("aria-current", "page");
				});
			};
			const scrollBtn = document.getElementById("scroll-indicator");
			const updateButtonIcon = () => {
				if (!scrollBtn) return;
				const secs = getSections();
				if (!secs.length) return;
				const isLast = currentId === secs[secs.length - 1].id;
				scrollBtn.setAttribute("aria-label", isLast ? "Volver al inicio" : "Ir a la siguiente sección");
				scrollBtn.querySelector('[data-scroll-icon="next"]')?.classList.toggle("hidden", isLast);
				scrollBtn.querySelector('[data-scroll-icon="home"]')?.classList.toggle("hidden", !isLast);
			};
			let viewportHeight = window.innerHeight;
			let documentTops: number[] = [];
			const measure = () => {
				viewportHeight = window.innerHeight;
				const scrollOffset = window.scrollY;
				documentTops = sections.map((section) => section.getBoundingClientRect().top + scrollOffset);
			};
			const visibleIndex = (threshold: number) => {
				const viewportTop = window.scrollY;
				let idx = -1;
				documentTops.forEach((top, index) => {
					if (top - viewportTop <= viewportHeight * threshold) idx = index;
				});
				return idx;
			};
			let scrollFrame = 0;
			const onScroll = () => {
				if (scrollFrame) return;
				scrollFrame = window.requestAnimationFrame(() => {
					scrollFrame = 0;
					const index = visibleIndex(0.35);
					const current = index >= 0 ? sections[index] : sections[0];
					if (current && current.id !== currentId) setActive(current.id);
					updateButtonIcon();
				});
			};
			measure();
			window.addEventListener("scroll", onScroll, { passive: true });
			window.addEventListener("resize", () => {
				measure();
				onScroll();
			});
			document.fonts?.ready.then(() => {
				measure();
				onScroll();
			});
			onScroll();
			navLinks.forEach((link) =>
				link.addEventListener("click", (event) => {
					setActive((link.getAttribute("href") || "").replace("#", ""));
					if (!(event instanceof MouseEvent)) return;
					const rect = link.getBoundingClientRect();
					const size = Math.max(rect.width, rect.height);
					const ripple = document.createElement("span");
					ripple.className = "ripple";
					ripple.style.width = ripple.style.height = `${size}px`;
					ripple.style.left = `${event.clientX - rect.left - size / 2}px`;
					ripple.style.top = `${event.clientY - rect.top - size / 2}px`;
					link.appendChild(ripple);
					ripple.addEventListener("animationend", () => ripple.remove());
				}),
			);
			document.addEventListener("click", (event) => {
				const targetElement = event.target instanceof Element ? event.target : null;
				if (!targetElement?.closest("#scroll-indicator")) return;
				if (!sections.length) return;
				const index = visibleIndex(0.5);
				const target = index >= sections.length - 1 ? sections[0] : sections[index + 1] || sections[0];
				target.scrollIntoView({ behavior: "smooth", block: "start" });
				setActive(target.id);
				updateButtonIcon();
			});
			if ("IntersectionObserver" in window) {
				document.documentElement.classList.add("reveal-enabled");
				const revealObserver = new IntersectionObserver(
					(entries) =>
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add("visible");
							revealObserver.unobserve(entry.target);
						}),
					{ threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
				);
				document.querySelectorAll(".reveal").forEach((element) => revealObserver.observe(element));
			}
		</script>
	</body>
</html>
