---
import type { NavItem } from '../types/cv';

interface Props {
	name: string;
	title: string;
	navItems: NavItem[];
	footer?: string;
}

const { name, title, navItems, footer = "Todos los derechos reservados" } = Astro.props;
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL('https://coboljcl.github.io');
const canonicalUrl = new URL(base, site).toString();
const socialImageUrl = new URL(`${base}og-banner.png`, site).toString();

const socials = [
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/allan-z%C3%BA%C3%B1iga-359957181", icon: "linkedin" },
	{ label: "GitHub", href: "https://github.com/coboljcl", icon: "github" },
];

const iconPaths: Record<string, string> = {
	linkedin: "M20 20h-4v-6a2 2 0 00-4 0v6h-4v-10h4v1.5A3.5 3.5 0 0019.5 12v8zM4 8h4v12H4zM6 4a2 2 0 110 4 2 2 0 010-4z",
	github: "M12 2a10 10 0 00-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 015 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0012 2z",
};

const navGlyphs: Record<string, string> = {
	inicio: "M3 12l9-9 9 9M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10",
	perfil: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
	trayectoria: "M5 2v12l-2 2m3-14h12a2 2 0 012 2v10a2 2 0 01-2 2H7a2 2 0 01-2-2V3z",
	experiencia: "M5 7h14M5 4h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2zM9 12h6",
	educacion: "M12 14l9-5-9-5-9 5 9 5zM12 14l6.16-3.42a12 12 0 01.67 6.48A12 12 0 0112 20.06a12 12 0 00-6.83-3A12 12 0 015.84 10.58L12 14zM5 8v6",
	tecnologias: "M8 9l-4 3 4 3M16 9l4 3-4 3M13 5l-2 14",
	habilidades: "M12 15a3 3 0 100-6 3 3 0 100 6zM5 12h2m10 0h2M12 5v2m0 10v2M6.34 6.34l1.41 1.41m8.49 8.49l1.41 1.41m0-11.31l-1.41 1.41M7.75 16.25l-1.41 1.41",
	contacto: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
};

const navItemsWithGlyphs = navItems.map((item) => ({ ...item, glyph: item.icon ? navGlyphs[item.icon] : undefined }));
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={`${name} — ${title} especializado en COBOL, DB2, JCL y CICS en entornos Mainframe para el sector bancario. 100+ programas implementados, más de 3 años de experiencia en sistemas críticos.`} />
		<meta name="theme-color" content="#0a0e17" />
		<meta name="author" content={name} />
		<meta name="keywords" content="Programador COBOL, Mainframe, DB2, JCL, CICS, desarrollador, ingeniero, sistemas críticos, banca, Allan Zúñiga" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={`${name} | ${title}`} />
		<meta property="og:description" content={`${title} especializado en COBOL y Mainframe para el sector bancario. 100+ programas implementados, más de 3 años de experiencia.`} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={`CV Online — ${name}`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${name} | ${title}`} />
		<meta name="twitter:description" content={`${title} especializado en COBOL y Mainframe para el sector bancario.`} />
		<meta name="twitter:image" content={socialImageUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
		<link rel="canonical" href={canonicalUrl} />
		<title>{name} | {title} · Mainframe</title>
	</head>
	<body class="font-['Geist',system-ui,sans-serif] bg-bg text-text antialiased overflow-x-hidden">
		<header class="site-header">
			<nav id="site-navigation" class="floating-nav" aria-label="Navegación principal">
				<a class="nav-brand" href="#inicio" aria-label={`Ir al inicio de ${name}`}>
					<span class="nav-avatar">
						<img src={`${base}assets/profile-avatar.jpg`} alt={`Foto de ${name}`} width="560" height="560" loading="eager" decoding="async" />
					</span>
					<span class="nav-identity">
						<strong>{name}</strong>
						<span>{title}</span>
					</span>
				</a>
				<div class="nav-links" role="list">
					{navItemsWithGlyphs.map((item) => (
						<a href={item.href} data-nav aria-current={item.href === '#inicio' ? 'page' : undefined} class:list={['nav-item', item.href === '#inicio' ? 'is-active' : '']}>
							{item.glyph && <svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.glyph} /></svg>}
							<span>{item.label}</span>
						</a>
					))}
				</div>
				<a class="nav-contact-cta" href="#contacto">
					<span>Contactar</span>
					<svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14m-6-6 6 6-6 6" /></svg>
				</a>
			</nav>
		</header>

		<main class="site-main">
			<div class="content-shell"><slot /></div>
			<footer class="site-footer">
				<div class="content-shell site-footer-content">
					<div class="footer-top-row">
						<div class="footer-brand">
							<p class="footer-name"><span aria-hidden="true">&gt;</span> {name}</p>
							<p class="footer-description">Especialista COBOL z/OS, DB2, CICS y arquitectura bancaria de alto volumen.</p>
						</div>
						<div class="footer-socials" aria-label="Perfiles profesionales">
							{socials.map((s) => (
								<a href={s.href} class="social-link" aria-label={`Abrir perfil de ${s.label} en una nueva pestaña`} target="_blank" rel="noopener noreferrer">
									<svg aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[s.icon]} /></svg>
									<span>{s.label}</span>
								</a>
							))}
						</div>
					</div>
					<div class="footer-bottom-row">
						<p>© {new Date().getFullYear()} {name}. {footer}.</p>
						<p>Diseñado con arquitectura moderna para sistemas bancarios críticos.</p>
					</div>
				</div>
			</footer>
		</main>

		<button id="scroll-indicator" type="button" class="scroll-indicator" aria-label="Ir a la siguiente sección">
			<svg class="icon-next w-5 h-5" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
			<svg class="icon-home w-5 h-5 hidden" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10" /></svg>
		</button>

		<script>
			const getSections = () => Array.from(document.querySelectorAll('main section[id]'));
			const navLinks = document.querySelectorAll('#site-navigation a[data-nav]');
			let currentId = '';
			const setActive = (id: string) => {
				currentId = id;
				navLinks.forEach((link) => {
					const isActive = link.getAttribute('href') === `#${id}`;
					link.classList.toggle('is-active', isActive);
					link.toggleAttribute('aria-current', isActive);
					if (isActive) link.setAttribute('aria-current', 'page');
				});
			};
			const scrollBtn = document.getElementById('scroll-indicator');
			const updateButtonIcon = () => {
				if (!scrollBtn) return;
				const secs = getSections();
				if (!secs.length) return;
				const isLast = currentId === secs[secs.length - 1].id;
				scrollBtn.setAttribute('aria-label', isLast ? 'Volver al inicio' : 'Ir a la siguiente sección');
				scrollBtn.querySelector('.icon-next')?.classList.toggle('hidden', isLast);
				scrollBtn.querySelector('.icon-home')?.classList.toggle('hidden', !isLast);
			};
			const currentIndex = () => {
				const sections = getSections();
				let idx = -1;
				sections.forEach((section, index) => { if (section.getBoundingClientRect().top <= window.innerHeight * 0.5) idx = index; });
				return idx;
			};
			const sections = getSections();
			const onScroll = () => {
				let current = sections[0];
				for (const section of sections) if (section.getBoundingClientRect().top <= window.innerHeight * 0.35) current = section;
				if (current && current.id !== currentId) setActive(current.id);
				updateButtonIcon();
			};
			window.addEventListener('scroll', onScroll, { passive: true });
			onScroll();
			navLinks.forEach((link) => link.addEventListener('click', (event) => {
				setActive((link.getAttribute('href') || '').replace('#', ''));
				if (!(event instanceof MouseEvent)) return;
				const rect = link.getBoundingClientRect();
				const size = Math.max(rect.width, rect.height);
				const ripple = document.createElement('span');
				ripple.className = 'ripple';
				ripple.style.width = ripple.style.height = `${size}px`;
				ripple.style.left = `${event.clientX - rect.left - size / 2}px`;
				ripple.style.top = `${event.clientY - rect.top - size / 2}px`;
				link.appendChild(ripple);
				ripple.addEventListener('animationend', () => ripple.remove());
			}));
			document.addEventListener('click', (event) => {
				const targetElement = event.target instanceof Element ? event.target : null;
				if (!targetElement?.closest('#scroll-indicator')) return;
				const secs = getSections();
				if (!secs.length) return;
				const index = currentIndex();
				const target = index === secs.length - 1 ? secs[0] : (secs[index + 1] || secs[0]);
				target.scrollIntoView({ behavior: 'smooth', block: 'start' });
				setActive(target.id);
				updateButtonIcon();
			});
			const revealObserver = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) entry.target.classList.add('visible'); }), { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
			document.querySelectorAll('.reveal').forEach((element) => revealObserver.observe(element));
		</script>
	</body>
</html>
