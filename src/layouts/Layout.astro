---
import type { NavItem } from '../types/cv';

interface Props {
	name: string;
	title: string;
	navItems: NavItem[];
	footer?: string;
}

const { name, title, navItems, footer = "Todos los derechos reservados" } = Astro.props;

// Base URL (respects GitHub Pages base path)
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL('https://coboljcl.github.io');
const canonicalUrl = new URL(base, site).toString();
const socialImageUrl = new URL(`${base}og-banner.png`, site).toString();

// Social links — solo LinkedIn y GitHub
const socials = [
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/allan-z%C3%BA%C3%B1iga-359957181", icon: "linkedin" },
	{ label: "GitHub", href: "https://github.com/coboljcl", icon: "github" },
];

const iconPaths: Record<string, string> = {
	linkedin:
		"M20 20h-4v-6a2 2 0 00-4 0v6h-4v-10h4v1.5A3.5 3.5 0 0019.5 12v8zM4 8h4v12H4zM6 4a2 2 0 110 4 2 2 0 010-4z",
	github:
		"M12 2a10 10 0 00-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 015 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0012 2z",
};

// Iconos por item de navegación (se muestran a la izquierda del texto)
const navGlyphs: Record<string, string> = {
	inicio: "M3 12l9-9 9 9M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10",
	perfil: "M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z",
	trayectoria: "M5 2v12l-2 2m3-14h12a2 2 0 012 2v10a2 2 0 01-2 2H7a2 2 0 01-2-2V3z",
	experiencia: "M5 7h14M5 4h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2zM9 12h6",
	educacion: "M12 14l9-5-9-5-9 5 9 5zM12 14l6.16-3.42a12 12 0 01.67 6.48A12 12 0 0112 20.06a12 12 0 00-6.83-3A12 12 0 015.84 10.58L12 14zM5 8v6",
	tecnologias: "M8 9l-4 3 4 3M16 9l4 3-4 3M13 5l-2 14",
	habilidades: "M12 15a3 3 0 100-6 3 3 0 000 6zM5 12h2m10 0h2M12 5v2m0 10v2M6.34 6.34l1.41 1.41m8.49 8.49l1.41 1.41m0-11.31l-1.41 1.41M7.75 16.25l-1.41 1.41",
	contacto: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
};

const navItemsWithGlyphs = navItems.map((item) => ({
	...item,
	glyph: item.icon ? navGlyphs[item.icon] : undefined,
}));
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={`${name} — ${title} especializado en COBOL, DB2, JCL y CICS en entornos Mainframe para el sector bancario. 100+ programas implementados, más de 2 años de experiencia en sistemas críticos.`} />
		<meta name="theme-color" content="#10151d" />
		<meta name="author" content={name} />
		<meta name="keywords" content="Programador COBOL, Mainframe, DB2, JCL, CICS, desarrollador, ingeniero, sistemas críticos, banca, Allan Zúñiga" />


		<!-- Open Graph (para compartir en LinkedIn / WhatsApp / Facebook) -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={`${name} | ${title}`} />
		<meta property="og:description" content={`${title} especializado en COBOL y Mainframe para el sector bancario. 100+ programas implementados, más de 2 años de experiencia.`} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content={`CV Online — ${name}`} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${name} | ${title}`} />
		<meta name="twitter:description" content={`${title} especializado en COBOL y Mainframe para el sector bancario.`} />
		<meta name="twitter:image" content={socialImageUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
		<link rel="canonical" href={canonicalUrl} />
		<title>{name} | {title} · Mainframe</title>
	</head>
	<body class="font-['Inter',system-ui,sans-serif] bg-bg text-text antialiased overflow-x-hidden">
		<div class="min-h-screen lg:flex">
			<!-- ===== Sidebar (sticky on desktop, collapsible on mobile) ===== -->
			<aside class="lg:sticky lg:top-0 lg:h-screen lg:w-80 lg:shrink-0 flex flex-col bg-surface border-b lg:border-b-0 lg:border-r border-line">
				<!-- Profile + mobile hamburger -->
				<div class="flex items-center justify-between gap-4 px-6 py-6 lg:flex-col lg:px-8 lg:pt-10 lg:pb-8 lg:text-center">
					<div class="flex items-center gap-4 lg:flex-col lg:gap-0">
						<div class="relative mb-0 lg:mb-5">
							<div class="w-16 h-16 lg:w-28 lg:h-28 rounded-full overflow-hidden ring-2 ring-primary/60 ring-offset-2 lg:ring-offset-4 ring-offset-surface">
								<img src={`${base}assets/profile-avatar.jpg`} alt={`Foto de ${name}`} width="560" height="560" loading="eager" decoding="async" class="w-full h-full object-cover" />
							</div>
							<span class="absolute bottom-1 right-1 w-4 h-4 rounded-full bg-accent border-2 border-surface" title="Disponible"></span>
						</div>
						<div class="lg:flex lg:flex-col lg:items-center">
							<h1 class="text-lg lg:text-xl font-bold text-white leading-tight">{name}</h1>
							<p class="text-sm font-medium text-primary">{title}</p>
						</div>
					</div>
					<button id="nav-toggle" type="button" class="lg:hidden flex items-center justify-center w-10 h-10 rounded-lg bg-nav hover:bg-nav-hover transition-colors" aria-label="Abrir menú de navegación" aria-controls="mobile-nav" aria-expanded="false">
						<svg class="w-5 h-5 text-white" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
						</svg>
					</button>
				</div>

				<!-- Navigation (collapsible on mobile) -->
				<nav id="mobile-nav" class="px-6 pb-8 lg:pb-8 hidden lg:block">
					<ul class="flex flex-col gap-2.5">
						{navItemsWithGlyphs.map((item) => (
							<li>
								<a
									href={item.href}
									data-nav
									class:list={[
										'nav-item',
										'group flex items-center gap-3 px-5 py-3 rounded-lg text-sm font-semibold uppercase tracking-wide transition-all duration-300 overflow-hidden',
										item.href === '#inicio' ? 'is-active' : '',
									]}
								>
									{item.glyph && (
										<svg class="w-4 h-4 shrink-0" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.glyph} />
										</svg>
									)}
									<span class="flex-1">{item.label}</span>
									<svg class="w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
									</svg>
								</a>
							</li>
						))}
					</ul>
				</nav>

				<!-- Desktop footer / social. Mobile version lives after the page content. -->
				<div class="hidden lg:block mt-auto px-6 pb-8 pt-4 border-t border-line">
					<p class="text-xs uppercase tracking-widest text-text-muted mb-4">Sígueme</p>
					<div class="flex gap-4">
						{socials.map((s) => (
							<a
								href={s.href}
								class="w-11 h-11 rounded-lg bg-nav hover:bg-primary transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/20 flex items-center justify-center text-white/70 hover:text-white"
								title={s.label}
								aria-label={`Abrir perfil de ${s.label} en una nueva pestaña`}
								target="_blank"
								rel="noopener noreferrer"
							>
								<svg class="w-4 h-4" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[s.icon]} />
								</svg>
							</a>
						))}
					</div>
					<p class="text-[11px] text-text-muted/60 mt-6 text-center">{footer}</p>
				</div>
			</aside>

			<!-- ===== Main content ===== -->
			<main class="flex-1 bg-bg min-w-0">
				<slot />

				<!-- Mobile footer / social. On desktop this content stays in the fixed sidebar. -->
				<footer class="lg:hidden px-8 py-10 bg-surface border-t border-line">
					<div class="max-w-6xl mx-auto">
						<p class="text-xs uppercase tracking-widest text-text-muted mb-4">Sígueme</p>
						<div class="flex gap-4">
							{socials.map((s) => (
								<a
									href={s.href}
									class="w-11 h-11 rounded-lg bg-nav hover:bg-primary transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/20 flex items-center justify-center text-white/70 hover:text-white"
									title={s.label}
									aria-label={`Abrir perfil de ${s.label} en una nueva pestaña`}
									target="_blank"
									rel="noopener noreferrer"
								>
									<svg class="w-4 h-4" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[s.icon]} />
									</svg>
								</a>
							))}
						</div>
						<p class="text-[11px] text-text-muted/60 mt-6">{footer}</p>
					</div>
				</footer>

				<!-- Floating "next section" button: always visible, bounces, works in every section -->
				<button id="scroll-indicator" type="button" class="fixed z-50 bottom-4 right-4 sm:bottom-6 sm:right-6 lg:right-8 flex items-center gap-2 group focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-bg rounded-full cursor-pointer" aria-label="Ir a la siguiente sección">
					<div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full border-2 border-primary/50 group-hover:border-primary group-hover:bg-primary/15 transition-colors flex items-center justify-center animate-bounce">
						<!-- Flecha hacia abajo (se muestra salvo en la última sección) -->
						<svg class="icon-next w-5 h-5 text-primary" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
						</svg>
						<!-- Icono home (se muestra en la última sección) -->
						<svg class="icon-home w-5 h-5 text-primary hidden" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l9-9 9 9M5 10v10a1 1 0 001 1h4v-6h4v6h4a1 1 0 001-1V10" />
						</svg>
					</div>
				</button>
			</main>
		</div>

		<script>
			// ==== Unified scroll + nav logic ====
			const getSections = () => Array.from(document.querySelectorAll('main section[id]'));
			const navLinks = document.querySelectorAll('aside nav a[data-nav]');
			let currentId = '';

			const setActive = (id: string) => {
				currentId = id;
				navLinks.forEach((link) => {
					const active = link.getAttribute('href') === `#${id}`;
					link.classList.toggle('is-active', active);
				});
			};

			// Toggle the scroll button icon: down-arrow everywhere, home at the last section
			const scrollBtn = document.getElementById('scroll-indicator');
			const updateButtonIcon = () => {
				if (!scrollBtn) return;
				const secs = getSections();
				if (!secs.length) return;
				const isLast = currentId === secs[secs.length - 1].id;
				const nextIco = scrollBtn.querySelector('.icon-next');
				const homeIco = scrollBtn.querySelector('.icon-home');
				if (nextIco) nextIco.classList.toggle('hidden', isLast);
				if (homeIco) homeIco.classList.toggle('hidden', !isLast);
			};

			const currentIndex = () => {
				const sections = getSections();
				if (!sections.length) return -1;
				let idx = -1;
				for (let i = 0; i < sections.length; i++) {
					const rect = sections[i].getBoundingClientRect();
					if (rect.top <= window.innerHeight * 0.5) idx = i;
				}
				return idx;
			};

			// Scroll-spy: highlight the nav item of the section in view (instant)
			const sections = getSections();
			const onScroll = () => {
				// Use the section whose top is just above the upper third of the viewport
				const marker = window.innerHeight * 0.35;
				let current = sections[0];
				for (const sec of sections) {
					const top = sec.getBoundingClientRect().top;
					if (top <= marker) current = sec;
				}
				if (current && current.id !== currentId) setActive(current.id);
				updateButtonIcon();
			};
			window.addEventListener('scroll', onScroll, { passive: true });
			onScroll();

			// Nav click → force active immediately + spawn ripple
			navLinks.forEach((link) => {
				link.addEventListener('click', (e) => {
					if (!(e instanceof MouseEvent)) return;
					const id = (link.getAttribute('href') || '').replace('#', '');
					if (id) setActive(id);

					// Ripple effect from the click point
					const rect = link.getBoundingClientRect();
					const size = Math.max(rect.width, rect.height);
					const ripple = document.createElement('span');
					ripple.className = 'ripple';
					ripple.style.width = ripple.style.height = size + 'px';
					ripple.style.left = (e.clientX - rect.left - size / 2) + 'px';
					ripple.style.top = (e.clientY - rect.top - size / 2) + 'px';
					link.appendChild(ripple);
					ripple.addEventListener('animationend', () => ripple.remove());
				});
			});

			// Floating button: go to next section, or back to top at the end
			document.addEventListener('click', (e) => {
				const targetElement = e.target instanceof Element ? e.target : null;
				const btn = targetElement?.closest('#scroll-indicator');
				if (!btn) return;
				const secs = getSections();
				if (!secs.length) return;
				const idx = currentIndex();
				const target = (idx === secs.length - 1) ? secs[0] : (secs[idx + 1] || secs[0]);
				target.scrollIntoView({ behavior: 'smooth', block: 'start' });
				setActive(target.id);
				updateButtonIcon();
			});

			// Reveal animations
			const revealObserver = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) entry.target.classList.add('visible');
					});
				},
				{ threshold: 0.1, rootMargin: '0px 0px -50px 0px' }
			);
			document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
		</script>
		<script is:inline>
			const navToggle = document.getElementById('nav-toggle');
			const mobileNav = document.getElementById('mobile-nav');
			if (navToggle && mobileNav) {
				navToggle.addEventListener('click', () => {
					const isExpanded = navToggle.getAttribute('aria-expanded') === 'true';
					mobileNav.classList.toggle('hidden', isExpanded);
					navToggle.setAttribute('aria-expanded', String(!isExpanded));
				});
			}
		</script>
	</body>
</html>
